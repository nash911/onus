{
  "name": "onus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "VITE_DEV_FIXTURES=1 vite",
    "gen:types": "json2ts -i ../../schema/result.schema.json -o src/types/result.ts --bannerComment \"/* Generated by npm run gen:types from schema/result.schema.json. Do not edit. */\" --additionalProperties false",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
