# --- Berget AI (all of Onus's own model calls go here) ---
BERGET_API_KEY=
BERGET_API_BASE=https://api.berget.ai/v1

# Model roles (Berget model ids, exactly as listed by GET /v1/models)
ONUS_MODEL_EXTRACT=zai-org/GLM-5.3-Flash
ONUS_MODEL_JUDGE=moonshotai/Kimi-K3.1-Pro
ONUS_MODEL_FAST=google/gemma-4-31B-it
ONUS_MODEL_EMBED=intfloat/multilingual-e5-large-instruct
ONUS_JUDGE_REASONING=high

# --- Spend guards (EUR) ---
ONUS_DEV_BUDGET_EUR=25
ONUS_MAX_EUR_PER_PAPER=1.50

# --- Paths and storage ---
ONUS_DATA_ROOT=./data/dev
ONUS_VAR_DIR=./var
DATABASE_URL=sqlite:///./var/onus.db
ONUS_RESULTS_IMPORT_DIR=./deploy_data

# --- Live analysis limits (the public app has no login) ---
LIVE_MAX_PER_DAY=40
LIVE_MAX_PER_IP_PER_HOUR=5
LIVE_MAX_COST_EUR_PER_DAY=10
LIVE_MAX_PDF_MB=20
FEATURED_PAPERS=

# --- Modal: authenticate once with `poetry run modal token new` (writes ~/.modal.toml) ---
ONUS_MODAL_APP=onus-rerun
ONUS_RERUN_MAX_MINUTES=30

# --- Provider keys passed INTO re-run sandboxes (optional) ---
# Only for papers whose own code calls these providers. The submitted code is untrusted and
# CAN READ these keys: use dedicated keys with low spending limits, and rotate them afterwards.
# Leave blank to mark such papers "not_run: needs external model". Never put Onus's own keys here.
SANDBOX_OPENAI_API_KEY=
SANDBOX_ANTHROPIC_API_KEY=
SANDBOX_GEMINI_API_KEY=
