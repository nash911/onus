# --- Model provider: every one of Onus's own model calls goes to this provider ---
# berget = v1.0.x (Berget AI: GLM / Kimi / Gemma / e5); gemini = v1.1 (Google Gemini API).
# The provider and every model setting below are part of the pipeline fingerprint.
ONUS_LLM_PROVIDER=berget

# --- Berget AI (used when ONUS_LLM_PROVIDER=berget) ---
BERGET_API_KEY=
BERGET_API_BASE=https://api.berget.ai/v1
# Model roles (Berget model ids, exactly as listed by GET /v1/models)
ONUS_MODEL_EXTRACT=zai-org/GLM-5.3-Flash
ONUS_MODEL_JUDGE=moonshotai/Kimi-K3.1-Pro
ONUS_MODEL_FAST=google/gemma-4-31B-it
ONUS_MODEL_EMBED=intfloat/multilingual-e5-large-instruct
# Judge reasoning: low | high | max
ONUS_JUDGE_REASONING=high

# --- Gemini (used when ONUS_LLM_PROVIDER=gemini) ---
# Onus's own key. Never SANDBOX_GEMINI_API_KEY, which belongs to paper code in re-run sandboxes.
GEMINI_API_KEY=
# Model roles (pinned, generally available Gemini API ids; docs/gemini_capabilities.md says why)
ONUS_GEMINI_MODEL_EXTRACT=gemini-3.8-flash
ONUS_GEMINI_MODEL_JUDGE=gemini-4-carbon
ONUS_GEMINI_MODEL_FAST=gemini-3.5-flash-lite
ONUS_GEMINI_MODEL_EMBED=gemini-embedding-2
# Judge thinking level: low | medium | high
ONUS_GEMINI_JUDGE_REASONING=high
# Judge calls get this many times each prompt's max_tokens (Gemini counts thinking against max_tokens)
ONUS_GEMINI_JUDGE_TOKEN_FACTOR=4
# Per-prompt judge thinking levels, prompt:level[,prompt:level] (these ran out of tokens or time at high)
ONUS_GEMINI_JUDGE_REASONING_OVERRIDES=scope_conflict:medium,baseline_support:medium,impl_match:medium
# Structured output: json_object (schema in the system message) | json_schema (regressed on dev)
ONUS_GEMINI_STRUCTURED_OUTPUT=json_object

# --- Spend guards (EUR) ---
ONUS_DEV_BUDGET_EUR=50
ONUS_MAX_EUR_PER_PAPER=1.50

# --- Paths and storage ---
ONUS_DATA_ROOT=./data/dev
ONUS_VAR_DIR=./var
DATABASE_URL=sqlite:///./var/onus.db
ONUS_RESULTS_IMPORT_DIR=./deploy_data

# --- Live analysis limits (the public app has no login) ---
LIVE_MAX_PER_DAY=40
LIVE_MAX_PER_IP_PER_HOUR=5
LIVE_MAX_COST_EUR_PER_DAY=10
LIVE_MAX_PDF_MB=20
FEATURED_PAPERS=

# --- Modal: tokens from https://modal.com/settings/tokens (no `modal token new` needed) ---
# Onus copies them into the process environment before importing modal. Never passed into a sandbox.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
ONUS_MODAL_APP=onus-rerun
ONUS_RERUN_MAX_MINUTES=30

# --- Provider keys passed INTO re-run sandboxes (optional) ---
# Only for papers whose own code calls these providers. The submitted code is untrusted and
# CAN READ these keys: use dedicated keys with low spending limits, and rotate them afterwards.
# Leave blank to mark such papers "not_run: needs external model". Never put Onus's own keys here.
SANDBOX_OPENAI_API_KEY=
SANDBOX_ANTHROPIC_API_KEY=
SANDBOX_GEMINI_API_KEY=
