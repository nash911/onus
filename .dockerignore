# Keep the build context (and the image) to what the app serves. Never ship data, caches or secrets.
.git
.gitignore
.gitmodules
.env
.env.*
!.env.example
.venv
.idea
.vscode
.claude
.hunknote
.pytest_cache
.ruff_cache
**/__pycache__
**/*.pyc

data/
var/*
!var/berget_capabilities.json
temp/
evals/
tests/
vendor/
scripts/
db/

docs/*
!docs/public/

src/frontend/node_modules
src/frontend/dist
src/frontend/.vite

Dockerfile
.dockerignore
README.md
